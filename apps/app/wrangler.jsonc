{
  // Local development only ("wrangler dev"). Actual deployment is managed
  // entirely by Terraform (see infra/main.tf's cloudflare_workers_script) -
  // this file is never used to deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poit",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "poit-artifacts" }
  ],
  "kv_namespaces": [
    { "binding": "METADATA", "id": "f61ec4f90da0410992258ead50b44c9d" }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "rowicy"
  }
}
